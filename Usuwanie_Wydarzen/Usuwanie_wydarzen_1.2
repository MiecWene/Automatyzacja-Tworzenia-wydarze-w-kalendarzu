 * DIALOG HTML
 ******************************/

function buildGroupDeleteDialogHtml_1_2(groupNames) {
  var data = JSON.stringify(groupNames);
  return '' +
'<!doctype html>' +
'<html><head><base target="_top">' +
'<meta charset="utf-8">' +
'<style>' +
'  body{font-family:Arial,Helvetica,sans-serif; padding:12px;}' +
'  .controls{display:flex; gap:8px; margin-bottom:10px; flex-wrap:wrap;}' +
'  button{padding:6px 10px;}' +
'  .list{border:1px solid #ddd; border-radius:6px; padding:10px; height:360px; overflow:auto;}' +
'  .row{display:flex; align-items:center; gap:8px; padding:4px 0;}' +
'  .danger{background:#b00020; color:white; border:none; border-radius:6px;}' +
'  .muted{color:#666; font-size:12px; margin-top:8px;}' +
'  .status{margin-top:10px; font-size:12px; white-space:pre-wrap;}' +
'</style>' +
'</head><body>' +
'<div class="controls">' +
'  <button type="button" onclick="selectAll(true)">Select all</button>' +
'  <button type="button" onclick="selectAll(false)">Clear</button>' +
'  <button type="button" class="danger" onclick="doDelete()">Delete selected</button>' +
'  <button type="button" onclick="google.script.host.close()">Cancel</button>' +
'</div>' +
'<div class="list" id="list"></div>' +
'<div class="muted">Deletes all recurring series and single events for the selected group names within their schedule date ranges (plus a small buffer).</div>' +
'<div class="status" id="status"></div>' +
'<script>' +
'const groups = ' + data + ';' +
'const list = document.getElementById("list");' +
'const statusEl = document.getElementById("status");' +
'function render(){' +
'  list.innerHTML = groups.map(g => ' +
'    `<label class="row"><input type="checkbox" value="${escapeHtml(g)}"> <span>${escapeHtml(g)}</span></label>`' +
'  ).join("");' +
'}' +
'function escapeHtml(s){' +
'  return String(s)' +
'    .replace(/&/g,"&amp;")' +
'    .replace(/</g,"&lt;")' +
'    .replace(/>/g,"&gt;");' +
'}' +
'function selectAll(on){' +
'  document.querySelectorAll("#list input[type=checkbox]").forEach(cb => cb.checked = on);' +
'}' +
'function doDelete(){' +
'  const selected = Array.from(document.querySelectorAll("#list input[type=checkbox]:checked")).map(cb => cb.value);' +
'  if(selected.length===0){ statusEl.textContent = "Select at least one group."; return; }' +
'  statusEl.textContent = `Deleting ${selected.length} group(s)…`;' +
'  google.script.run' +
'    .withSuccessHandler(res => {' +
'      if(res && res.ok){' +
'        const series = res.totalSeries || 0;' +
'        const single = res.totalSingle || 0;' +
'        statusEl.textContent = `Done. Deleted ${series} series and ${single} single events. See Delete_Report sheet for details.`;' +
'      } else {' +
'        statusEl.textContent = "Done, but no summary returned. See Delete_Report sheet.";'+
'      }' +
'    })' +
'    .withFailureHandler(err => {' +
'      statusEl.textContent = "Failed: " + (err && err.message ? err.message : String(err));' +
'    })' +
'    .handleDeleteGroups_1_2_fromDialog(selected);' +
'}' +
'render();' +
'</script>' +
'</body></html>';
}

/******************************
 * SCHEDULE PARSING (minimal)
 ******************************/

var HEADER_GROUP_NAME_1_2 = 'Nazwa Grupy';
var HEADER_START_DATE_1_2 = 'Data startu';
var HEADER_END_DATE_1_2 = 'Data końca';

function readScheduleRows_1_2(sheet) {
  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  var headerRow = values[0];
  var headers = headerRow.map(String);

  var rows = [];
  for (var i = 1; i < values.length; i++) {
    var map = {};
    for (var c = 0; c < headers.length; c++) {
      map[headers[c]] = values[i][c];
    }
    rows.push({ rowIndex: i + 1, values: map });
  }
  return rows;
}

function valueByHeader_1_2(valuesMap, headerName) {
  if (valuesMap.hasOwnProperty(headerName)) return valuesMap[headerName];
  var target = String(headerName).replace(/\s+/g, ' ').trim();
  for (var key in valuesMap) {
    if (!valuesMap.hasOwnProperty(key)) continue;
    var normKey = String(key).replace(/\s+/g, ' ').trim();
    if (normKey === target) return valuesMap[key];
  }
  return undefined;
}

function parseDateCell_1_2(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return new Date(value.getTime());
  }
  if (typeof value === 'string') {
    var d = new Date(value);
    if (isNaN(d.getTime())) return null;
    return d;
  }
  return null;
}

function buildGroupInfo_1_2(sheet) {
  var rows = readScheduleRows_1_2(sheet);
  var info = {};

  rows.forEach(function(r) {
    var groupName = valueByHeader_1_2(r.values, HEADER_GROUP_NAME_1_2);
    if (!groupName) return;
    groupName = String(groupName).trim();
    if (!groupName) return;

    var startRaw = valueByHeader_1_2(r.values, HEADER_START_DATE_1_2);
    var endRaw = valueByHeader_1_2(r.values, HEADER_END_DATE_1_2);
    var start = parseDateCell_1_2(startRaw);
    var end = parseDateCell_1_2(endRaw);
    if (!start || !end) return;

    // Keep widest window across rows for the group
    if (!info[groupName]) {
      info[groupName] = { startDate: start, endDate: end };
    } else {
      if (start.getTime() < info[groupName].startDate.getTime()) {
        info[groupName].startDate = start;
      }
      if (end.getTime() > info[groupName].endDate.getTime()) {
        info[groupName].endDate = end;
      }
    }
  });

  return info;
}

/******************************
 * REPORTING
 ******************************/

function writeDeleteReport_1_2(ss, results) {
  var sheet = ss.getSheetByName(DELETE_REPORT_SHEET_NAME_1_2);
  if (!sheet) sheet = ss.insertSheet(DELETE_REPORT_SHEET_NAME_1_2);

  sheet.clearContents();
  var header = ['Timestamp', 'GroupName', 'StartDate', 'EndDate', 'SeriesDeleted', 'SingleDeleted', 'Error'];
  var rows = [header];

  var ts = new Date();
  results.forEach(function(r) {
    rows.push([
      ts,
      r.groupName || '',
      r.startDate || '',
      r.endDate || '',
      r.seriesDeletedCount || 0,
      r.singleDeletedCount || 0,
      r.error || ''
    ]);
  });

  sheet.getRange(1, 1, rows.length, header.length).setValues(rows);
}