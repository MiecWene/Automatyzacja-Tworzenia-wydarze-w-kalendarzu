// Calendar id where events live
var CALENDAR_ID_1_2 =
  'c_102b836f14297b1391e79d8c20c718e237d77ca6bea51c2ae5b9e7659e918897@group.calendar.google.com';

// Sheet tab containing schedule (same as main script)
var SCHEDULE_SHEET_NAME_1_2 = 'Test_Schedule_Month_Script';

// Where to write deletion audit
var DELETE_REPORT_SHEET_NAME_1_2 = 'Delete_Report';

// Search buffer around schedule window when locating events
var DELETE_WINDOW_BUFFER_DAYS_1_2 = 7;

/**
 * Helper to force Apps Script to request Spreadsheet + Calendar scopes.
 * Run once manually if needed.
 */
function authorizeDeleteTool_1_2() {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName(SCHEDULE_SHEET_NAME_1_2);
  if (!sheet) throw new Error('Schedule sheet "' + SCHEDULE_SHEET_NAME_1_2 + '" not found');

  var calendar = CalendarApp.getCalendarById(CALENDAR_ID_1_2);
  if (!calendar) throw new Error('Calendar with id ' + CALENDAR_ID_1_2 + ' not found or not accessible');

  // No-op reads to ensure access
  ss.getName();
  calendar.getName();
}

/******************************
 * ENTRYPOINT – CHECKBOX DIALOG
 ******************************/

/**
 * Main UI entrypoint for 1.2:
 * - Reads all groups from the schedule
 * - Shows an HtmlService dialog with checkboxes per group
 * - Calls handleDeleteGroups_1_2_fromDialog(selectedNames) on "Delete selected"
 *
 * Wire your menu to this function, e.g.:
 *   .addItem('Delete group events…', 'deleteEventsByGroup_1_2_dialog')
 */
function deleteEventsByGroup_1_2_dialog() {
  var ss = SpreadsheetApp.getActive();
  var scheduleSheet = ss.getSheetByName(SCHEDULE_SHEET_NAME_1_2);
  if (!scheduleSheet) throw new Error('Schedule sheet "' + SCHEDULE_SHEET_NAME_1_2 + '" not found');

  var groupInfo = buildGroupInfo_1_2(scheduleSheet); // { groupName: {startDate, endDate} }
  var groupNames = Object.keys(groupInfo).sort();

  if (groupNames.length === 0) {
    SpreadsheetApp.getUi().alert('No groups found in "' + SCHEDULE_SHEET_NAME_1_2 + '".');
    return;
  }

  var html = buildGroupDeleteDialogHtml_1_2(groupNames);
  SpreadsheetApp.getUi().showModalDialog(
    HtmlService.createHtmlOutput(html).setWidth(520).setHeight(560),
    'Delete group events'
  );
}

/**
 * Called by the HTML dialog via google.script.run.
 * Deletes all recurring series + all single events
 * for each selected group within that group's schedule date range (+/- buffer),
 * and writes an audit report.
 *
 * Returns a small summary for the client JS to display.
 */
function handleDeleteGroups_1_2_fromDialog(selectedGroupNames) {
  var result = handleDeleteGroups_1_2(selectedGroupNames || []);
  var totalSeries = 0;
  var totalSingle = 0;

  if (result && result.deleted && result.deleted.forEach) {
    result.deleted.forEach(function(r) {
      if (!r) return;
      totalSeries += r.seriesDeletedCount || 0;
      totalSingle += r.singleDeletedCount || 0;
    });
  }

  return {
    ok: true,
    totalSeries: totalSeries,
    totalSingle: totalSingle,
    deleted: result.deleted || []
  };
}

/**
 * Pure core – no UI. Same scheme as 1.1:
 * - Uses schedule date ranges per group (+/- buffer)
 * - Deletes recurring series (once per series) and single events
 * - Writes Delete_Report_1_2
 */
function handleDeleteGroups_1_2(selectedGroupNames) {
  if (!selectedGroupNames || !selectedGroupNames.length) {
    return { ok: true, deleted: [] };
  }

  var ss = SpreadsheetApp.getActive();
  var scheduleSheet = ss.getSheetByName(SCHEDULE_SHEET_NAME_1_2);
  if (!scheduleSheet) throw new Error('Schedule sheet "' + SCHEDULE_SHEET_NAME_1_2 + '" not found');

  var calendar = CalendarApp.getCalendarById(CALENDAR_ID_1_2);
  if (!calendar) throw new Error('Calendar with id ' + CALENDAR_ID_1_2 + ' not found or not accessible');

  var groupInfo = buildGroupInfo_1_2(scheduleSheet);
  var results = [];

  selectedGroupNames.forEach(function(groupName) {
    var info = groupInfo[groupName];
    if (!info) {
      results.push({ groupName: groupName, error: 'Group not found in schedule' });
      return;
    }

    var startWindow = new Date(info.startDate.getTime());
    startWindow.setDate(startWindow.getDate() - DELETE_WINDOW_BUFFER_DAYS_1_2);
    var endWindow = new Date(info.endDate.getTime());
    endWindow.setDate(endWindow.getDate() + DELETE_WINDOW_BUFFER_DAYS_1_2);

    var events = calendar.getEvents(startWindow, endWindow);

    var seriesDeletedById = {};
    var seriesDeletedCount = 0;
    var singleDeletedCount = 0;

    events.forEach(function(e) {
      if (e.getTitle() !== groupName) return;

      if (e.isRecurringEvent()) {
        // Multiple instances point to the same series; delete once.
        var series = e.getEventSeries();
        var seriesId = '';
        try {
          seriesId = series.getId();
        } catch (err) {
          seriesId = String(new Date().getTime()) + Math.random();
        }
        if (seriesDeletedById[seriesId]) return;
        seriesDeletedById[seriesId] = true;
        series.deleteEventSeries();
        seriesDeletedCount++;
      } else {
        e.deleteEvent();
        singleDeletedCount++;
      }
    });

    results.push({
      groupName: groupName,
      startDate: info.startDate,
      endDate: info.endDate,
      seriesDeletedCount: seriesDeletedCount,
      singleDeletedCount: singleDeletedCount
    });
  });

  writeDeleteReport_1_2(ss, results);
  return { ok: true, deleted: results };
}

