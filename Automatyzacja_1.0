/******************************
 * CONFIG
 ******************************/

// Require Calendar Advanced Service (Extensions > Advanced Google Services > Google Calendar API)
// for adding trial guests to a single occurrence via Calendar.Events.instances + patch.

// Calendar id from the spec
var CALENDAR_ID = 'c_3820bc90d9604b08016510447742d4a70a85beb977ca03884dc44fa04a9833b7@group.calendar.google.com';

// Sheet and tab names
var SCHEDULE_SHEET_NAME = 'Test_Schedule_Month_Script';
var REPORT_SHEET_NAME = 'Run_Report';

// Behavior toggles
var PHASE1_ONLY = false; // true = validation + reporting only, no calendar changes
var CREATE_EVENTS_WITH_NO_CONFIRMED_ATTENDEES = false; // BEH-11: skip groups with no confirmed (and no trial) participants

// Retry for transient Calendar API errors (e.g. "Service unavailable: Calendar")
var CALENDAR_RETRY_ATTEMPTS = 3;
var CALENDAR_RETRY_DELAY_MS = 2500;

/******************************
 * ENTRYPOINT
 ******************************/

function runSync() {
  var now = new Date();
  var reportEntries = [];

  try {
    var ss = SpreadsheetApp.getActive();
    var scheduleSheet = ss.getSheetByName(SCHEDULE_SHEET_NAME);
    if (!scheduleSheet) {
      throw new Error('Schedule sheet "' + SCHEDULE_SHEET_NAME + '" not found');
    }

    var rawRows = readScheduleRows(scheduleSheet);
    var validation = validateAndGroup(rawRows, reportEntries);

    // Phase 1: malformed rows + conflicts already logged into reportEntries
    if (PHASE1_ONLY) {
      writeRunReport(ss, reportEntries);
      return;
    }

    // Phase 2/3/4: calendar operations + more report entries
    var calendar = CalendarApp.getCalendarById(CALENDAR_ID);
    if (!calendar) {
      throw new Error('Calendar with id ' + CALENDAR_ID + ' not found or not accessible');
    }

    upsertEventsForGroups(calendar, validation, reportEntries);

    // Finally write the run report
    writeRunReport(ss, reportEntries);
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'API_FAILURE',
      errorReason: String(e),
      details: 'Fatal error in runSync'
    }));
    var ss2 = SpreadsheetApp.getActive();
    if (ss2) {
      writeRunReport(ss2, reportEntries);
    }
    Logger.log('Fatal error: ' + e.stack);
  }
}

/******************************
 * DATA MODELS (conceptual)
 ******************************/

// RawRow: { rowIndex: number, values: { headerName: any } }
// ValidatedRow, GroupBucket modeled as plain JS objects

/******************************
 * CONSTANTS FOR HEADERS
 ******************************/

var HEADER_EMAIL = 'Uczestnik (Email)';
var HEADER_GROUP = 'Nazwa Grupy';
var HEADER_START_DATE = 'Data startu';
var HEADER_END_DATE = 'Data końca';
var HEADER_DAY1 = 'Dzień #1';
var HEADER_TIME1 = 'Godzina #1 (hh:mm)';
var HEADER_DAY2 = 'Dzień #2';
var HEADER_TIME2 = 'Godzina #2 (hh:mm)';
var HEADER_CONFIRMED = 'Confirmed';
var HEADER_TRIAL_DATE = 'Data zajęć próbnych';
var HEADER_ZOOM = 'Zoom link';
var HEADER_TEACHER = 'Nauczyciel';
var HEADER_DROPBOX = 'Link do dropbox';
var HEADER_MIRO = 'Link do Miro';

/******************************
 * READING + VALIDATION (Phase 1)
 ******************************/

function readScheduleRows(sheet) {
  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  var headerRow = values[0];
  var dataRows = values.slice(1);

  var headers = headerRow.map(String);
  var result = [];

  for (var i = 0; i < dataRows.length; i++) {
    var rowVals = dataRows[i];
    var map = {};
    for (var c = 0; c < headers.length; c++) {
      map[headers[c]] = rowVals[c];
    }
    result.push({
      rowIndex: i + 2, // 1-based, +1 for header row
      values: map
    });
  }
  return result;
}

function validateAndGroup(rawRows, reportEntries) {
  var validRows = [];
  var malformedRows = [];
  var conflicts = [];

  for (var i = 0; i < rawRows.length; i++) {
    var raw = rawRows[i];
    var res = validateRow(raw);
    if (res.isError) {
      malformedRows.push(res.error);
    } else {
      validRows.push(res.value);
    }
  }

  // Group valid rows by groupName
  var groupsByName = {};
  validRows.forEach(function(r) {
    if (!groupsByName[r.groupName]) groupsByName[r.groupName] = [];
    groupsByName[r.groupName].push(r);
  });

  var validGroups = [];

  Object.keys(groupsByName).forEach(function(groupName) {
    var rows = groupsByName[groupName];
    // Prefer a row that has a second slot defined (Dzień #2 / Godzina #2),
    // so group schedule includes both slots when any row defines them.
    var first = rows[0];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r.day2 && r.time2) {
        first = r;
        break;
      }
    }
    var canonicalSchedule = buildGroupSchedule(first);

    var conflictingIndices = [];
    for (var j = 1; j < rows.length; j++) {
      if (!schedulesMatch(canonicalSchedule, rows[j])) {
        conflictingIndices.push(rows[j].rowIndex);
      }
    }

    if (conflictingIndices.length > 0) {
      conflicts.push({
        groupName: groupName,
        rowIndices: [first.rowIndex].concat(conflictingIndices),
        reason: 'Conflicting schedule-defining fields within group'
      });
    } else {
      validGroups.push({
        groupName: groupName,
        rows: rows,
        schedule: canonicalSchedule
      });
    }
  });

  // Log malformed rows
  malformedRows.forEach(function(m) {
    reportEntries.push(makeReportEntry({
      action: 'ROW_MALFORMED',
      rowIndex: m.rowIndex,
      groupName: m.groupName,
      errorReason: m.reason
    }));
  });

  // Log conflicts
  conflicts.forEach(function(c) {
    reportEntries.push(makeReportEntry({
      action: 'GROUP_CONFLICT',
      groupName: c.groupName,
      details: 'Rows: ' + c.rowIndices.join(', '),
      errorReason: c.reason
    }));
  });

  return {
    validGroups: validGroups,
    conflictingGroups: conflicts,
    malformedRows: malformedRows
  };
}

function validateRow(raw) {
  // Flexible header lookup: tolerate non-breaking spaces and extra whitespace
  var v = function(h) {
    if (raw.values.hasOwnProperty(h)) return raw.values[h];
    var target = String(h).replace(/\s+/g, ' ').trim();
    for (var key in raw.values) {
      if (!raw.values.hasOwnProperty(key)) continue;
      var normKey = String(key).replace(/\s+/g, ' ').trim();
      if (normKey === target) return raw.values[key];
    }
    return undefined;
  };

  var emailRaw = v(HEADER_EMAIL);
  var groupRaw = v(HEADER_GROUP);
  var startRaw = v(HEADER_START_DATE);
  var endRaw = v(HEADER_END_DATE);
  var day1Raw = v(HEADER_DAY1);
  var time1Raw = v(HEADER_TIME1);

  var missing = [];
  if (!emailRaw) missing.push(HEADER_EMAIL);
  if (!groupRaw) missing.push(HEADER_GROUP);
  if (!startRaw) missing.push(HEADER_START_DATE);
  if (!endRaw) missing.push(HEADER_END_DATE);
  if (!day1Raw) missing.push(HEADER_DAY1);
  if (!time1Raw) missing.push(HEADER_TIME1);

  var groupName = typeof groupRaw === 'string' ? groupRaw.trim() : undefined;

  if (missing.length > 0) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Missing required fields: ' + missing.join(', ')
      }
    };
  }

  if (!isValidEmail(emailRaw)) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed participant email'
      }
    };
  }

  var startDate = parseDateCell(startRaw);
  var endDate = parseDateCell(endRaw);
  if (!startDate || !endDate) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed start or end date'
      }
    };
  }

  var day1 = parseWeekdayToken(day1Raw);
  var time1 = parseTimeOfDay(time1Raw);
  if (!day1 || !time1) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed primary day or time'
      }
    };
  }

  var day2Raw = v(HEADER_DAY2);
  var time2Raw = v(HEADER_TIME2);

  var day2 = null;
  var time2 = null;

  var hasDay2 = day2Raw !== null && day2Raw !== '' && day2Raw !== undefined;
  var hasTime2 = time2Raw !== null && time2Raw !== '' && time2Raw !== undefined;

  if (hasDay2 && hasTime2) {
    day2 = parseWeekdayToken(day2Raw);
    time2 = parseTimeOfDay(time2Raw);
    // Only error if both are present but invalid
    if (!day2 || !time2) {
      return {
        isError: true,
        error: {
          rowIndex: raw.rowIndex,
          groupName: groupName,
          reason: 'Malformed secondary day or time'
        }
      };
    }
  } else {
    // One or both are empty → treat as “no second slot” (per BEH-03), no error
    day2 = null;
    time2 = null;
  }

  var trialRaw = v(HEADER_TRIAL_DATE);
  var trialDate = null;
  if (trialRaw !== null && trialRaw !== '' && trialRaw !== undefined) {
    trialDate = parseDateCell(trialRaw);
    if (!trialDate) {
      return {
        isError: true,
        error: {
          rowIndex: raw.rowIndex,
          groupName: groupName,
          reason: 'Malformed trial date'
        }
      };
    }
  }

  var confirmed = parseBooleanCell(v(HEADER_CONFIRMED));

  var zoomLink = v(HEADER_ZOOM);
  var teacherName = v(HEADER_TEACHER);
  var dropboxLink = v(HEADER_DROPBOX);
  var miroLink = v(HEADER_MIRO);

  return {
    isError: false,
    value: {
      rowIndex: raw.rowIndex,
      groupName: groupName || '',
      participantEmail: String(emailRaw).trim(),
      confirmed: confirmed,
      zoomLink: typeof zoomLink === 'string' ? zoomLink.trim() : '',
      teacherName: typeof teacherName === 'string' ? teacherName.trim() : '',
      dropboxLink: typeof dropboxLink === 'string' ? dropboxLink.trim() : '',
      miroLink: typeof miroLink === 'string' ? miroLink.trim() : '',
      startDate: startDate,
      endDate: endDate,
      day1: day1,
      time1: time1,
      day2: day2,
      time2: time2,
      trialDate: trialDate
    }
  };
}

/******************************
 * PARSERS
 ******************************/

function parseWeekdayToken(value) {
  if (typeof value !== 'string') return null;
  var raw = value.trim();
  if (!raw) return null;

  // Normalize common variants:
  // - case-insensitive (tue, TUE)
  // - with trailing punctuation (Tue.)
  // - Polish abbreviations (Pn, Wt, Śr/Sr, Cz, Pt)
  var t = raw.replace(/[.\s]+$/g, '').toLowerCase();

  // English short
  if (t.length >= 3) {
    var first3 = t.slice(0, 3);
    if (first3 === 'mon') return 'Mon';
    if (first3 === 'tue') return 'Tue';
    if (first3 === 'wed') return 'Wed';
    if (first3 === 'thu') return 'Thu';
    if (first3 === 'fri') return 'Fri';
  }

  // Polish short
  if (t === 'pn') return 'Mon';
  if (t === 'wt') return 'Tue';
  if (t === 'sr' || t === 'śr') return 'Wed';
  if (t === 'cz') return 'Thu';
  if (t === 'pt') return 'Fri';

  return null;
}

function parseTimeOfDay(value) {
  // If it's a time cell, Apps Script often gives a Date
  if (Object.prototype.toString.call(value) === '[object Date]') {
    var d = new Date(value.getTime());
    return {
      hour: d.getHours(),
      minute: d.getMinutes()
    };
  }

  // Sometimes times are stored as numbers (fraction of a day)
  if (typeof value === 'number') {
    var totalMinutes = Math.round(value * 24 * 60);
    var h = Math.floor(totalMinutes / 60);
    var mm = totalMinutes % 60;
    if (h < 0 || h > 23 || mm < 0 || mm > 59) return null;
    return { hour: h, minute: mm };
  }

  // Fallback: string in HH:mm
  if (typeof value === 'string') {
    // Accept "H:MM", "HH:MM", and also "H.MM" / "H,MM" (common in some locales)
    var m = /^(\d{1,2})[:.,](\d{2})$/.exec(value.trim());
    if (!m) return null;
    var h2 = Number(m[1]);
    var mm2 = Number(m[2]);
    if (isNaN(h2) || isNaN(mm2) || h2 < 0 || h2 > 23 || mm2 < 0 || mm2 > 59) return null;
    return { hour: h2, minute: mm2 };
  }

  return null;
}

function parseDateCell(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return new Date(value.getTime());
  }
  if (typeof value === 'string') {
    var d = new Date(value);
    if (isNaN(d.getTime())) return null;
    return d;
  }
  return null;
}

function endOfDay(date) {
  var d = new Date(date.getTime());
  d.setHours(23, 59, 59, 999);
  return d;
}

function startOfNextDay(date) {
  var d = new Date(date.getTime());
  d.setDate(d.getDate() + 1);
  d.setHours(0, 0, 0, 0);
  return d;
}

function parseBooleanCell(value) {
  if (typeof value === 'boolean') return value;
  if (typeof value === 'string') {
    var t = value.trim().toLowerCase();
    return t === 'true' || t === 'yes' || t === '1';
  }
  if (typeof value === 'number') return value !== 0;
  return false;
}

function isValidEmail(value) {
  if (typeof value !== 'string') return false;
  var s = value.trim();
  var re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(s);
}

/******************************
 * GROUP SCHEDULE COMPARISON
 ******************************/

function buildGroupSchedule(row) {
  var slots = [{
    weekday: row.day1,
    time: row.time1
  }];
  if (row.day2 && row.time2) {
    slots.push({
      weekday: row.day2,
      time: row.time2
    });
  }
  return {
    startDate: row.startDate,
    endDate: row.endDate,
    slots: slots
  };
}

function schedulesMatch(schedule, row) {
  var other = buildGroupSchedule(row);
  if (schedule.startDate.getTime() !== other.startDate.getTime()) return false;
  if (schedule.endDate.getTime() !== other.endDate.getTime()) return false;
  if (schedule.slots.length !== other.slots.length) return false;
  for (var i = 0; i < schedule.slots.length; i++) {
    var a = schedule.slots[i];
    var b = other.slots[i];
    if (a.weekday !== b.weekday) return false;
    if (a.time.hour !== b.time.hour || a.time.minute !== b.time.minute) return false;
  }
  return true;
}

/******************************
 * TEMPLATE RENDERING (Phase 3)
 ******************************/

var RAW_TEMPLATE = '' +
'Pay attention that all lessons are conducted in zoom\n' +
'{{zoom link}}\n\n' +
'Your teacher\'s name is {{Nauczyciel}}.\n' +
'All lessons are recorded so you can rewatch them to review the material or in case you skipped one.\n\n' +
'You can watch them here\n' +
'{{to ma hyperlink do Dropbox}}\n\n' +
'You will work with the miro board Classroom board\n' +
'{link do Miro}';

function renderInvitationBody(row) {
  var body = RAW_TEMPLATE;

  body = body.replace('{{zoom link}}', row.zoomLink || '');
  body = body.replace('{{Nauczyciel}}', row.teacherName || '');

  var dropbox = row.dropboxLink || '';
  var hyperlink = '<a href="' + dropbox + '">You can watch them here</a>';
  body = body.replace('{{to ma hyperlink do Dropbox}}', hyperlink);

  body = body.replace('{link do Miro}', row.miroLink || '');

  return body;
}

/******************************
 * CALENDAR OPERATIONS (Phase 2)
 ******************************/

/**
 * Runs fn(); on "Service unavailable" or Calendar-related exception, retries up to
 * CALENDAR_RETRY_ATTEMPTS with CALENDAR_RETRY_DELAY_MS between attempts.
 */
function runWithCalendarRetry(fn) {
  var lastErr;
  for (var attempt = 1; attempt <= CALENDAR_RETRY_ATTEMPTS; attempt++) {
    try {
      return fn();
    } catch (e) {
      lastErr = e;
      var msg = (e && e.message) ? String(e.message) : String(e);
      if (attempt < CALENDAR_RETRY_ATTEMPTS && (msg.indexOf('Service unavailable') !== -1 || msg.indexOf('Calendar') !== -1)) {
        Utilities.sleep(CALENDAR_RETRY_DELAY_MS);
      } else {
        throw e;
      }
    }
  }
  throw lastErr;
}

function upsertEventsForGroups(calendar, validation, reportEntries) {
  validation.validGroups.forEach(function(bucket) {
    var parts = partitionParticipants(bucket);
    var seriesParticipants = parts.seriesParticipants;
    var trialParticipants = parts.trialParticipants;

    var seriesEmails = seriesParticipants.map(function(r) { return r.participantEmail; });
    var canonicalRow = seriesParticipants[0] || bucket.rows[0];
    var description = renderInvitationBody(canonicalRow);

    var needSeries = seriesEmails.length > 0 || trialParticipants.length > 0 || CREATE_EVENTS_WITH_NO_CONFIRMED_ATTENDEES;
    if (!needSeries) {
      reportEntries.push(makeReportEntry({
        action: 'GROUP_SKIPPED_NO_ATTENDEES',
        groupName: bucket.groupName,
        details: 'Group has no confirmed non-trial participants'
      }));
      return;
    }

    var slots = bucket.schedule.slots;
    if (slots.length < 2) {
      reportEntries.push(makeReportEntry({
        action: 'DEBUG_ONLY_ONE_SLOT',
        groupName: bucket.groupName,
        details: 'slots.length=' + slots.length + '; day1=' + (slots[0] ? slots[0].weekday : '') +
          ' time1=' + (slots[0] ? (slots[0].time.hour + ':' + (slots[0].time.minute < 10 ? '0' : '') + slots[0].time.minute) : '')
      }));
    }

    // Primary slot (Dzień #1 / Godzina #1)
    var primarySlot = slots[0];
    var existingSeriesPrimary = findExistingGroupSeriesForSlot(calendar, bucket, primarySlot) || findExistingGroupSeries(calendar, bucket);
    var primarySeries;
    if (existingSeriesPrimary) {
      updateSeries(calendar, existingSeriesPrimary, bucket, primarySlot, seriesEmails, description, reportEntries);
      primarySeries = existingSeriesPrimary;
    } else {
      primarySeries = createSeries(calendar, bucket, primarySlot, seriesEmails, description, reportEntries);
    }

    // Secondary slot (Dzień #2 / Godzina #2) if present
    if (slots.length > 1 && slots[1] && slots[1].weekday && slots[1].time) {
      var secondarySlot = slots[1];
      var existingSeriesSecondary = findExistingGroupSeriesForSlot(calendar, bucket, secondarySlot);
      if (existingSeriesSecondary) {
        updateSeries(calendar, existingSeriesSecondary, bucket, secondarySlot, seriesEmails, description, reportEntries);
      } else {
        createSeries(calendar, bucket, secondarySlot, seriesEmails, description, reportEntries);
      }
    }

    // Trial participants: attach to the correct series (slot) based on the trial date weekday
    if (trialParticipants.length > 0) {
      if (primarySeries && !existingSeriesPrimary) {
        // Give API a moment to index newly created series
        Utilities.sleep(1500);
      }

      trialParticipants.forEach(function(row) {
        if (!row.trialDate) return;
        var jsDay = row.trialDate.getDay(); // 0-6
        var token = jsDayToToken(jsDay);
        if (!token) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_SLOT_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'Trial date weekday not supported for ' + row.participantEmail
          }));
          return;
        }

        // Find matching slot for this weekday
        var matchingSlot = null;
        for (var si = 0; si < slots.length; si++) {
          var s = slots[si];
          if (s && s.weekday === token) {
            matchingSlot = s;
            break;
          }
        }

        if (!matchingSlot) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_SLOT_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'No slot for weekday ' + token + ' for ' + row.participantEmail
          }));
          return;
        }

        var recurringEventIdForSlot = getRecurringEventIdForSlotByListing(
          CALENDAR_ID,
          bucket.groupName,
          matchingSlot,
          bucket.schedule.startDate,
          bucket.schedule.endDate
        );

        if (!recurringEventIdForSlot) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_INSTANCE_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'No recurring series found for weekday ' + token +
              ' and time ' + matchingSlot.time.hour + ':' + (matchingSlot.time.minute < 10 ? '0' : '') + matchingSlot.time.minute,
            errorReason: 'No matching recurring series for slot'
          }));
          return;
        }

        addTrialGuestToInstance(
          CALENDAR_ID,
          recurringEventIdForSlot,
          row.trialDate,
          row.participantEmail,
          matchingSlot,
          reportEntries,
          bucket.groupName,
          row.rowIndex
        );
      });
    }
  });
}

function partitionParticipants(bucket) {
  var series = [];
  var trials = [];

  bucket.rows.forEach(function(row) {
    var hasTrial = row.trialDate &&
      row.trialDate.getTime() >= bucket.schedule.startDate.getTime() &&
      row.trialDate.getTime() <= bucket.schedule.endDate.getTime();

    if (hasTrial && row.confirmed) {
      trials.push(row);
    } else if (row.confirmed) {
      series.push(row);
    }
  });

  return {
    seriesParticipants: series,
    trialParticipants: trials
  };
}

function toAppsScriptWeekday(token) {
  switch (token) {
    case 'Mon': return CalendarApp.Weekday.MONDAY;
    case 'Tue': return CalendarApp.Weekday.TUESDAY;
    case 'Wed': return CalendarApp.Weekday.WEDNESDAY;
    case 'Thu': return CalendarApp.Weekday.THURSDAY;
    case 'Fri': return CalendarApp.Weekday.FRIDAY;
    default: throw new Error('Unsupported weekday token: ' + token);
  }
}

function jsWeekdayFromToken(token) {
  // JS getDay(): Sun=0, Mon=1, ... Sat=6
  switch (token) {
    case 'Mon': return 1;
    case 'Tue': return 2;
    case 'Wed': return 3;
    case 'Thu': return 4;
    case 'Fri': return 5;
    default:
      throw new Error('Unsupported weekday token for alignment: ' + token);
  }
}

function jsDayToToken(jsDay) {
  // JS getDay(): Sun=0, Mon=1, ... Sat=6
  switch (jsDay) {
    case 1: return 'Mon';
    case 2: return 'Tue';
    case 3: return 'Wed';
    case 4: return 'Thu';
    case 5: return 'Fri';
    default: return null;
  }
}

function alignDateToWeekday(baseDate, weekdayToken) {
  var targetDow = jsWeekdayFromToken(weekdayToken);
  var d = new Date(baseDate.getTime());
  var currentDow = d.getDay(); // 0–6
  var delta = (targetDow - currentDow + 7) % 7; // 0–6 days forward
  d.setDate(d.getDate() + delta);
  return d;
}

function createSeries(calendar, bucket, slot, emails, description, reportEntries) {
  var schedule = bucket.schedule;
  var primarySlot = slot;

  var alignedStartDate = alignDateToWeekday(schedule.startDate, primarySlot.weekday);
  var start = new Date(alignedStartDate.getTime());
  start.setHours(primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000); // 1 hour

  var recurrence = CalendarApp.newRecurrence()
    .addWeeklyRule()
    .until(startOfNextDay(schedule.endDate));

  // Only this slot's weekday
  recurrence.onlyOnWeekday(toAppsScriptWeekday(primarySlot.weekday));
  recurrence.setTimeZone(Session.getScriptTimeZone());

  var eventSeries = runWithCalendarRetry(function() {
    var series = calendar.createEventSeries(bucket.groupName, start, end, recurrence, {
      description: description,
      guests: emails.join(','),
      sendInvites: false
    });
    return series;
  });

  reportEntries.push(makeReportEntry({
    action: 'EVENT_CREATED',
    groupName: bucket.groupName,
    details: 'Created recurring event; attendees: ' + emails.length
  }));
  return eventSeries;
}

function updateSeries(calendar, series, bucket, slot, emails, description, reportEntries) {
  // Update description always (idempotent enough)
  series.setDescription(description);

  // Update recurrence if schedule changed: for simplicity, we always reset
  var schedule = bucket.schedule;
  var primarySlot = slot;
  var alignedStartDate = alignDateToWeekday(schedule.startDate, primarySlot.weekday);
  var start = new Date(alignedStartDate.getTime());
  start.setHours(primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000);
  var recurrence = CalendarApp.newRecurrence()
    .addWeeklyRule()
    .until(startOfNextDay(schedule.endDate));

  recurrence.onlyOnWeekday(toAppsScriptWeekday(primarySlot.weekday));
  recurrence.setTimeZone(Session.getScriptTimeZone());

  runWithCalendarRetry(function() {
    series.setTime(start, end);
    series.setRecurrence(recurrence);

    var currentGuests = series.getGuestList().map(function(g) { return g.getEmail(); });
    var desired = {};
    emails.forEach(function(e) { desired[e] = true; });

    currentGuests.forEach(function(email) {
      if (!desired[email]) {
        series.removeGuest(email);
      }
    });

    emails.forEach(function(email) {
      if (currentGuests.indexOf(email) === -1) {
        series.addGuest(email);
      }
    });
  });

  reportEntries.push(makeReportEntry({
    action: 'EVENT_UPDATED',
    groupName: bucket.groupName,
    details: 'Updated recurring event; attendees: ' + emails.length
  }));
}

function findExistingGroupSeries(calendar, bucket) {
  // Approximate: find recurring events with matching title whose first occurrence
  // falls within the group date range.
  var startWindow = new Date(bucket.schedule.startDate.getTime());
  startWindow.setDate(startWindow.getDate() - 7);
  var endWindow = new Date(bucket.schedule.endDate.getTime());
  endWindow.setDate(endWindow.getDate() + 7);

  var events = calendar.getEvents(startWindow, endWindow);
  for (var i = 0; i < events.length; i++) {
    var e = events[i];
    if (!e.isRecurringEvent()) continue;
    if (e.getTitle() !== bucket.groupName) continue;

    var eStart = e.getStartTime();
    if (eStart >= bucket.schedule.startDate && eStart <= bucket.schedule.endDate) {
      return e.getEventSeries();
    }
  }
  return null;
}

function findExistingGroupSeriesForSlot(calendar, bucket, slot) {
  var schedule = bucket.schedule;
  var startWindow = new Date(schedule.startDate.getTime());
  startWindow.setDate(startWindow.getDate() - 7);
  var endWindow = new Date(schedule.endDate.getTime());
  endWindow.setDate(endWindow.getDate() + 7);

  var desiredDow = jsWeekdayFromToken(slot.weekday);
  var desiredHour = slot.time.hour;
  var desiredMinute = slot.time.minute;

  var events = calendar.getEvents(startWindow, endWindow);
  for (var i = 0; i < events.length; i++) {
    var e = events[i];
    if (!e.isRecurringEvent()) continue;
    if (e.getTitle() !== bucket.groupName) continue;

    var eStart = e.getStartTime();
    if (eStart < schedule.startDate || eStart > schedule.endDate) continue;
    if (eStart.getDay() !== desiredDow) continue;
    if (eStart.getHours() !== desiredHour || eStart.getMinutes() !== desiredMinute) continue;

    return e.getEventSeries();
  }
  return null;
}

/**
 * Returns the recurring event id for the series (for use with Calendar API instances/patch).
 * CalendarEventSeries.getId() returns iCalUID; the API instances() endpoint needs the short event id.
 * So we look up the recurring event by listing events in the schedule range and matching by title.
 */
function getRecurringEventIdFromSeries(series) {
  try {
    return series.getId();
  } catch (e) {
    return null;
  }
}

/**
 * Gets the short recurring event id for a specific slot via Calendar API list.
 * Filters by groupName, date window, weekday and time for the slot.
 */
function getRecurringEventIdForSlotByListing(calendarId, groupName, slot, startDate, endDate) {
  try {
    var startWindow = new Date(startDate.getTime());
    startWindow.setDate(startWindow.getDate() - 7);
    var endWindow = new Date(endDate.getTime());
    endWindow.setDate(endWindow.getDate() + 7);

    var timeMin = startWindow.toISOString();
    var timeMax = startOfNextDay(endWindow).toISOString();

    var desiredDow = jsWeekdayFromToken(slot.weekday);
    var desiredHour = slot.time.hour;
    var desiredMinute = slot.time.minute;

    var response = Calendar.Events.list(calendarId, {
      timeMin: timeMin,
      timeMax: timeMax,
      singleEvents: false
    });
    var items = response.items || [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      if (item.summary !== groupName) continue;
      if (!item.recurrence) continue;

      var startField = item.start && (item.start.dateTime || item.start.date);
      if (!startField) continue;
      var d = new Date(startField);
      if (isNaN(d.getTime())) continue;

      if (d.getDay() !== desiredDow) continue;

      // If this is a timed event, also check the time of day
      if (item.start.dateTime) {
        if (d.getHours() !== desiredHour || d.getMinutes() !== desiredMinute) continue;
      }

      return item.id;
    }
  } catch (e) {
    // fall through
  }
  return null;
}

/**
 * Adds trial guest to the single occurrence on trialDate via Calendar API (per-slot).
 * Requires Calendar Advanced Service (Google Calendar API) to be enabled.
 */
function addTrialGuestToInstance(calendarId, recurringEventId, trialDate, trialEmail, slot, reportEntries, groupName, rowIndex) {
  var primarySlot = slot;
  // Use calendar date (y/m/d) in script timezone so "2026-03-11" in sheet stays March 11, not March 10 UTC
  var y = trialDate.getFullYear();
  var m = trialDate.getMonth();
  var d = trialDate.getDate();
  var start = new Date(y, m, d, primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000);
  var timeMin = start.toISOString();
  var timeMax = end.toISOString();
  var dateStr = y + '-' + (m + 1 < 10 ? '0' : '') + (m + 1) + '-' + (d < 10 ? '0' : '') + d;

  try {
    runWithCalendarRetry(function() {
      var response = Calendar.Events.instances(calendarId, recurringEventId, {
        timeMin: timeMin,
        timeMax: timeMax
      });
      var items = response.items || [];
      if (items.length === 0) {
        reportEntries.push(makeReportEntry({
          action: 'TRIAL_INSTANCE_NOT_FOUND',
          groupName: groupName,
          rowIndex: rowIndex,
          details: 'No occurrence on ' + dateStr + ' for trial guest ' + trialEmail,
          errorReason: 'Instance not in recurrence window or series not found'
        }));
        return;
      }
      var instance = items[0];
      var attendees = instance.attendees || [];
      var hasAlready = attendees.some(function(a) { return a.email === trialEmail; });
      if (!hasAlready) {
        attendees.push({ email: trialEmail });
        var timeZone = Session.getScriptTimeZone();
        var exceptionEvent = {
          recurringEventId: recurringEventId,
          originalStartTime: instance.originalStartTime || { dateTime: timeMin, timeZone: timeZone },
          start: instance.start || { dateTime: timeMin, timeZone: timeZone },
          end: instance.end || { dateTime: timeMax, timeZone: timeZone },
          summary: instance.summary || groupName,
          description: instance.description || '',
          attendees: attendees
        };
        Calendar.Events.insert(exceptionEvent, calendarId, { sendUpdates: 'none' });
      }
      reportEntries.push(makeReportEntry({
        action: 'TRIAL_GUEST_ADDED_TO_INSTANCE',
        groupName: groupName,
        rowIndex: rowIndex,
        details: 'Added ' + trialEmail + ' to occurrence on ' + dateStr
      }));
    });
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'TRIAL_GUEST_ADD_FAILED',
      groupName: groupName,
      rowIndex: rowIndex,
      details: 'Failed to add trial guest ' + trialEmail + ' to instance on ' + dateStr,
      errorReason: String(e)
    }));
  }
}

/******************************
 * RUN REPORT (Phase 1 & 4)
 ******************************/

function makeReportEntry(fields) {
  return {
    timestamp: new Date(),
    rowIndex: fields.rowIndex || '',
    groupName: fields.groupName || '',
    action: fields.action || '',
    details: fields.details || '',
    errorReason: fields.errorReason || ''
  };
}

function writeRunReport(ss, entries) {
  var sheet = ss.getSheetByName(REPORT_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(REPORT_SHEET_NAME);
  }

  sheet.clearContents();

  var header = ['Timestamp', 'RowIndex', 'GroupName', 'Action', 'Details', 'ErrorReason'];
  var rows = [header];

  entries.forEach(function(e) {
    rows.push([
      e.timestamp,
      e.rowIndex,
      e.groupName,
      e.action,
      e.details,
      e.errorReason
    ]);
  });

  var range = sheet.getRange(1, 1, rows.length, header.length);
  range.setValues(rows);
}

/******************************
 * OPTIONAL: MENU
 ******************************/

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Zarządzanie wydarzeniami')
    .addItem('Utwórz wydarzenia', 'runSync')
    .addSeparator()
    .addItem('Usuń wydarzenia', 'deleteEventsByGroup_1_1_withUi')
    .addToUi();
}