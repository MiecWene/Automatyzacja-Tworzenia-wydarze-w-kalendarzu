/******************************
 * CONFIG
 ******************************/

// Require Calendar Advanced Service (Extensions > Advanced Google Services > Google Calendar API)
// for adding trial guests to a single occurrence via Calendar.Events.instances + patch.

// Calendar id default (kept empty; main source is the sheet `Calendar ID` column)
var CALENDAR_ID = '';

// Sheet and tab names
var SCHEDULE_SHEET_NAME = 'Schedule_Month_Script';
var REPORT_SHEET_NAME = 'Run_Report';

// Behavior toggles
var PHASE1_ONLY = false; // true = validation + reporting only, no calendar changes
var CREATE_EVENTS_WITH_NO_CONFIRMED_ATTENDEES = false; // BEH-11: skip groups with no confirmed (and no trial) participants

// Retry for transient Calendar API errors (e.g. "Service unavailable: Calendar")
var CALENDAR_RETRY_ATTEMPTS = 3;
var CALENDAR_RETRY_DELAY_MS = 2500;

// Managed recurring series: private extended property on the master event (Calendar API v3)
var MANAGED_SERIES_PRIVATE_KEY = 'atwkManagedSeries_v1';

// If true, obsolete-series cleanup only logs what it would do (no delete/trim)
var OBSOLETE_SERIES_CLEANUP_DRY_RUN = false;

/******************************
 * ENTRYPOINT
 ******************************/

function runSync() {
  var now = new Date();
  var reportEntries = [];

  try {
    var ss = SpreadsheetApp.getActive();
    var scheduleSheet = ss.getSheetByName(SCHEDULE_SHEET_NAME);
    if (!scheduleSheet) {
      throw new Error('Schedule sheet "' + SCHEDULE_SHEET_NAME + '" not found');
    }

    var sheetCalendarId = getCalendarIdFromSheet(scheduleSheet);
    var calendarId = sheetCalendarId || CALENDAR_ID;
    if (!calendarId) {
      throw new Error('Calendar ID is not configured. Please fill the \"Calendar ID\" column in sheet \"' +
        SCHEDULE_SHEET_NAME + '\" or set CALENDAR_ID in the script.');
    }

    var rawRows = readScheduleRows(scheduleSheet);
    var validation = validateAndGroup(rawRows, reportEntries);

    // Phase 1: malformed rows + conflicts already logged into reportEntries
    if (PHASE1_ONLY) {
      writeRunReport(ss, reportEntries);
      return;
    }

    // Phase 2/3/4: calendar operations + more report entries
    var calendar = CalendarApp.getCalendarById(calendarId);
    if (!calendar) {
      throw new Error('Calendar with id ' + calendarId + ' not found or not accessible');
    }

    var desiredManagedKeys = {};
    upsertEventsForGroups(calendar, validation, reportEntries, calendarId, desiredManagedKeys);
    cleanupObsoleteManagedSeries(calendarId, desiredManagedKeys, reportEntries);

    // Finally write the run report
    writeRunReport(ss, reportEntries);

    // Show confirmation: which groups had events created and how many per group
    showCreatedEventsSummary(reportEntries);
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'API_FAILURE',
      errorReason: String(e),
      details: 'Fatal error in runSync'
    }));
    var ss2 = SpreadsheetApp.getActive();
    if (ss2) {
      writeRunReport(ss2, reportEntries);
    }
    Logger.log('Fatal error: ' + e.stack);
  }
}

/******************************
 * DATA MODELS (conceptual)
 ******************************/

// RawRow: { rowIndex: number, values: { headerName: any } }
// ValidatedRow, GroupBucket modeled as plain JS objects

/******************************
 * CONSTANTS FOR HEADERS
 ******************************/

var HEADER_EMAIL = 'Uczestnik (Email)';
var HEADER_GROUP = 'Nazwa Grupy';
var HEADER_CALENDAR_ID = 'Calendar ID';
var HEADER_START_DATE = 'Data startu';
var HEADER_END_DATE = 'Data końca';
var HEADER_DAY1 = 'Dzień #1';
var HEADER_TIME1 = 'Godzina #1 (hh:mm)';
var HEADER_DAY2 = 'Dzień #2';
var HEADER_TIME2 = 'Godzina #2 (hh:mm)';
var HEADER_CONFIRMED = 'Confirmed';
var HEADER_TRIAL_DATE = 'Data zajęć próbnych';
var HEADER_ZOOM = 'Link zoom z bazy';
var HEADER_TEACHER = 'Nauczyciel';
var HEADER_DROPBOX = 'Link do dropbox';
var HEADER_MIRO = 'Link do Miro';

/******************************
 * READING + VALIDATION (Phase 1)
 ******************************/

function readScheduleRows(sheet) {
  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  var headerRow = values[0];
  var dataRows = values.slice(1);

  var headers = headerRow.map(String);
  var result = [];

  for (var i = 0; i < dataRows.length; i++) {
    var rowVals = dataRows[i];
    var map = {};
    for (var c = 0; c < headers.length; c++) {
      map[headers[c]] = rowVals[c];
    }
    result.push({
      rowIndex: i + 2, // 1-based, +1 for header row
      values: map
    });
  }
  return result;
}

function getCalendarIdFromSheet(sheet) {
  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return null;

  var headerRow = values[0];
  var calendarColIndex = -1;

  for (var c = 0; c < headerRow.length; c++) {
    if (String(headerRow[c]) === HEADER_CALENDAR_ID) {
      calendarColIndex = c;
      break;
    }
  }

  if (calendarColIndex === -1) return null;

  for (var r = 1; r < values.length; r++) {
    var cell = values[r][calendarColIndex];
    if (cell !== '' && cell != null) {
      return String(cell).trim();
    }
  }

  return null;
}

function validateAndGroup(rawRows, reportEntries) {
  var validRows = [];
  var malformedRows = [];
  var conflicts = [];

  for (var i = 0; i < rawRows.length; i++) {
    var raw = rawRows[i];
    var res = validateRow(raw);
    if (res.isError) {
      malformedRows.push(res.error);
    } else {
      validRows.push(res.value);
    }
  }

  // Group valid rows by groupName
  var groupsByName = {};
  validRows.forEach(function(r) {
    if (!groupsByName[r.groupName]) groupsByName[r.groupName] = [];
    groupsByName[r.groupName].push(r);
  });

  var validGroups = [];

  Object.keys(groupsByName).forEach(function(groupName) {
    var rows = groupsByName[groupName];
    // Prefer a row that has a second slot defined (Dzień #2 / Godzina #2),
    // so group schedule includes both slots when any row defines them.
    var first = rows[0];
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (r.day2 && r.time2) {
        first = r;
        break;
      }
    }
    var canonicalSchedule = buildGroupSchedule(first);

    var conflictingIndices = [];
    for (var j = 1; j < rows.length; j++) {
      if (!schedulesMatch(canonicalSchedule, rows[j])) {
        conflictingIndices.push(rows[j].rowIndex);
      }
    }

    if (conflictingIndices.length > 0) {
      conflicts.push({
        groupName: groupName,
        rowIndices: [first.rowIndex].concat(conflictingIndices),
        reason: 'Conflicting schedule-defining fields within group'
      });
    } else {
      validGroups.push({
        groupName: groupName,
        rows: rows,
        schedule: canonicalSchedule
      });
    }
  });

  // Log malformed rows
  malformedRows.forEach(function(m) {
    reportEntries.push(makeReportEntry({
      action: 'ROW_MALFORMED',
      rowIndex: m.rowIndex,
      groupName: m.groupName,
      errorReason: m.reason
    }));
  });

  // Log conflicts
  conflicts.forEach(function(c) {
    reportEntries.push(makeReportEntry({
      action: 'GROUP_CONFLICT',
      groupName: c.groupName,
      details: 'Rows: ' + c.rowIndices.join(', '),
      errorReason: c.reason
    }));
  });

  return {
    validGroups: validGroups,
    conflictingGroups: conflicts,
    malformedRows: malformedRows
  };
}

function validateRow(raw) {
  // Flexible header lookup: tolerate non-breaking spaces and extra whitespace
  var v = function(h) {
    if (raw.values.hasOwnProperty(h)) return raw.values[h];
    var target = String(h).replace(/\s+/g, ' ').trim();
    for (var key in raw.values) {
      if (!raw.values.hasOwnProperty(key)) continue;
      var normKey = String(key).replace(/\s+/g, ' ').trim();
      if (normKey === target) return raw.values[key];
    }
    return undefined;
  };

  var emailRaw = v(HEADER_EMAIL);
  var groupRaw = v(HEADER_GROUP);
  var startRaw = v(HEADER_START_DATE);
  var endRaw = v(HEADER_END_DATE);
  var day1Raw = v(HEADER_DAY1);
  var time1Raw = v(HEADER_TIME1);

  var missing = [];
  if (!emailRaw) missing.push(HEADER_EMAIL);
  if (!groupRaw) missing.push(HEADER_GROUP);
  if (!startRaw) missing.push(HEADER_START_DATE);
  if (!endRaw) missing.push(HEADER_END_DATE);
  if (!day1Raw) missing.push(HEADER_DAY1);
  if (!time1Raw) missing.push(HEADER_TIME1);

  var groupName = typeof groupRaw === 'string' ? groupRaw.trim() : undefined;

  if (missing.length > 0) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Missing required fields: ' + missing.join(', ')
      }
    };
  }

  if (!isValidEmail(emailRaw)) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed participant email'
      }
    };
  }

  var startDate = parseDateCell(startRaw);
  var endDate = parseDateCell(endRaw);
  if (!startDate || !endDate) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed start or end date'
      }
    };
  }

  var day1 = parseWeekdayToken(day1Raw);
  var time1 = parseTimeOfDay(time1Raw);
  if (!day1 || !time1) {
    return {
      isError: true,
      error: {
        rowIndex: raw.rowIndex,
        groupName: groupName,
        reason: 'Malformed primary day or time'
      }
    };
  }

  var day2Raw = v(HEADER_DAY2);
  var time2Raw = v(HEADER_TIME2);

  var day2 = null;
  var time2 = null;

  var hasDay2 = day2Raw !== null && day2Raw !== '' && day2Raw !== undefined;
  var hasTime2 = time2Raw !== null && time2Raw !== '' && time2Raw !== undefined;

  if (hasDay2 && hasTime2) {
    day2 = parseWeekdayToken(day2Raw);
    time2 = parseTimeOfDay(time2Raw);
    // Only error if both are present but invalid
    if (!day2 || !time2) {
      return {
        isError: true,
        error: {
          rowIndex: raw.rowIndex,
          groupName: groupName,
          reason: 'Malformed secondary day or time'
        }
      };
    }
  } else {
    // One or both are empty → treat as “no second slot” (per BEH-03), no error
    day2 = null;
    time2 = null;
  }

  var trialRaw = v(HEADER_TRIAL_DATE);
  var trialDate = null;
  if (trialRaw !== null && trialRaw !== '' && trialRaw !== undefined) {
    trialDate = parseDateCell(trialRaw);
    if (!trialDate) {
      return {
        isError: true,
        error: {
          rowIndex: raw.rowIndex,
          groupName: groupName,
          reason: 'Malformed trial date'
        }
      };
    }
  }

  var confirmed = parseBooleanCell(v(HEADER_CONFIRMED));

  var zoomLink = v(HEADER_ZOOM);
  var teacherName = v(HEADER_TEACHER);
  var dropboxLink = v(HEADER_DROPBOX);
  var miroLink = v(HEADER_MIRO);

  return {
    isError: false,
    value: {
      rowIndex: raw.rowIndex,
      groupName: groupName || '',
      participantEmail: String(emailRaw).trim(),
      confirmed: confirmed,
      zoomLink: typeof zoomLink === 'string' ? zoomLink.trim() : '',
      teacherName: typeof teacherName === 'string' ? teacherName.trim() : '',
      dropboxLink: typeof dropboxLink === 'string' ? dropboxLink.trim() : '',
      miroLink: typeof miroLink === 'string' ? miroLink.trim() : '',
      startDate: startDate,
      endDate: endDate,
      day1: day1,
      time1: time1,
      day2: day2,
      time2: time2,
      trialDate: trialDate
    }
  };
}

/******************************
 * PARSERS
 ******************************/

function parseWeekdayToken(value) {
  if (typeof value !== 'string') return null;
  var raw = value.trim();
  if (!raw) return null;

  // Normalize common variants:
  // - case-insensitive (tue, TUE)
  // - with trailing punctuation (Tue.)
  // - Polish abbreviations (Pn, Wt, Śr/Sr, Cz, Pt)
  var t = raw.replace(/[.\s]+$/g, '').toLowerCase();

  // English short
  if (t.length >= 3) {
    var first3 = t.slice(0, 3);
    if (first3 === 'mon') return 'Mon';
    if (first3 === 'tue') return 'Tue';
    if (first3 === 'wed') return 'Wed';
    if (first3 === 'thu') return 'Thu';
    if (first3 === 'fri') return 'Fri';
  }

  // Polish short
  if (t === 'pn') return 'Mon';
  if (t === 'wt') return 'Tue';
  if (t === 'sr' || t === 'śr') return 'Wed';
  if (t === 'cz') return 'Thu';
  if (t === 'pt') return 'Fri';

  return null;
}

function parseTimeOfDay(value) {
  // If it's a time cell, Apps Script often gives a Date
  if (Object.prototype.toString.call(value) === '[object Date]') {
    var d = new Date(value.getTime());
    return {
      hour: d.getHours(),
      minute: d.getMinutes()
    };
  }

  // Sometimes times are stored as numbers (fraction of a day)
  if (typeof value === 'number') {
    var totalMinutes = Math.round(value * 24 * 60);
    var h = Math.floor(totalMinutes / 60);
    var mm = totalMinutes % 60;
    if (h < 0 || h > 23 || mm < 0 || mm > 59) return null;
    return { hour: h, minute: mm };
  }

  // Fallback: string in HH:mm
  if (typeof value === 'string') {
    // Accept "H:MM", "HH:MM", and also "H.MM" / "H,MM" (common in some locales)
    var m = /^(\d{1,2})[:.,](\d{2})$/.exec(value.trim());
    if (!m) return null;
    var h2 = Number(m[1]);
    var mm2 = Number(m[2]);
    if (isNaN(h2) || isNaN(mm2) || h2 < 0 || h2 > 23 || mm2 < 0 || mm2 > 59) return null;
    return { hour: h2, minute: mm2 };
  }

  return null;
}

function parseDateCell(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return new Date(value.getTime());
  }
  if (typeof value === 'string') {
    var d = new Date(value);
    if (isNaN(d.getTime())) return null;
    return d;
  }
  return null;
}

function endOfDay(date) {
  var d = new Date(date.getTime());
  d.setHours(23, 59, 59, 999);
  return d;
}

function startOfNextDay(date) {
  var d = new Date(date.getTime());
  d.setDate(d.getDate() + 1);
  d.setHours(0, 0, 0, 0);
  return d;
}

function parseBooleanCell(value) {
  if (typeof value === 'boolean') return value;
  if (typeof value === 'string') {
    var t = value.trim().toLowerCase();
    return t === 'true' || t === 'yes' || t === '1';
  }
  if (typeof value === 'number') return value !== 0;
  return false;
}

function isValidEmail(value) {
  if (typeof value !== 'string') return false;
  var s = value.trim();
  var re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  return re.test(s);
}

/******************************
 * GROUP SCHEDULE COMPARISON
 ******************************/

function buildGroupSchedule(row) {
  var slots = [{
    weekday: row.day1,
    time: row.time1
  }];
  if (row.day2 && row.time2) {
    slots.push({
      weekday: row.day2,
      time: row.time2
    });
  }
  return {
    startDate: row.startDate,
    endDate: row.endDate,
    slots: slots
  };
}

function schedulesMatch(schedule, row) {
  var other = buildGroupSchedule(row);
  if (schedule.startDate.getTime() !== other.startDate.getTime()) return false;
  if (schedule.endDate.getTime() !== other.endDate.getTime()) return false;
  if (schedule.slots.length !== other.slots.length) return false;
  for (var i = 0; i < schedule.slots.length; i++) {
    var a = schedule.slots[i];
    var b = other.slots[i];
    if (a.weekday !== b.weekday) return false;
    if (a.time.hour !== b.time.hour || a.time.minute !== b.time.minute) return false;
  }
  return true;
}

/******************************
 * TEMPLATE RENDERING (Phase 3)
 ******************************/

var RAW_TEMPLATE = '' +
'Pay attention that all lessons are conducted in zoom\n' +
'{{zoom link}}\n\n' +
'Your teacher\'s name is {{Nauczyciel}}.\n' +
'All lessons are recorded so you can rewatch them to review the material or in case you skipped one.\n\n' +
'{{to ma hyperlink do Dropbox}}\n\n' +
'You will work with the miro board\n' +
'{link do Miro}';

function renderInvitationBody(row) {
  var body = RAW_TEMPLATE;

  function escapeHtmlText(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // Escape values for safe inclusion into HTML attributes (Calendar description supports basic HTML).
  function escapeHtmlAttribute(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function splitMultiLinks(cellValue) {
    if (cellValue == null) return [];
    if (typeof cellValue !== 'string') return [];
    return cellValue
      .split(/[\n,;]+/g)
      .map(function(x) { return x.trim(); })
      .filter(function(x) { return x.length > 0; });
  }

  function renderAnchors(cellValue, linkText) {
    var links = splitMultiLinks(cellValue);
    if (links.length === 0) return '';
    return links.map(function(href, idx) {
      var text = links.length > 1 ? (linkText + ' ' + (idx + 1)) : linkText;
      return '<a href="' + escapeHtmlAttribute(href) + '">' + escapeHtmlText(text) + '</a>';
    }).join('<br/>');
  }

  body = body.replace('{{zoom link}}', renderAnchors(row.zoomLink || '', 'Zoom link'));
  body = body.replace('{{Nauczyciel}}', row.teacherName || '');

  body = body.replace('{{to ma hyperlink do Dropbox}}',
    renderAnchors(row.dropboxLink || '', 'You can watch them here'));

  body = body.replace('{link do Miro}', renderAnchors(row.miroLink || '', 'Classroom board'));

  return body;
}

/******************************
 * CALENDAR OPERATIONS (Phase 2)
 ******************************/

/**
 * Runs fn(); on "Service unavailable" or Calendar-related exception, retries up to
 * CALENDAR_RETRY_ATTEMPTS with CALENDAR_RETRY_DELAY_MS between attempts.
 */
function runWithCalendarRetry(fn) {
  var lastErr;
  for (var attempt = 1; attempt <= CALENDAR_RETRY_ATTEMPTS; attempt++) {
    try {
      return fn();
    } catch (e) {
      lastErr = e;
      var msg = (e && e.message) ? String(e.message) : String(e);
      if (attempt < CALENDAR_RETRY_ATTEMPTS && (msg.indexOf('Service unavailable') !== -1 || msg.indexOf('Calendar') !== -1)) {
        Utilities.sleep(CALENDAR_RETRY_DELAY_MS);
      } else {
        throw e;
      }
    }
  }
  throw lastErr;
}

function escapeManagedSeriesSegment(s) {
  return String(s).replace(/\|/g, '_');
}

/**
 * Stable id for a group's recurring slot; stored in Calendar extendedProperties.private.
 */
function buildManagedSeriesPrivateValue(groupName, slot, slotIndex) {
  return [
    'v1',
    escapeManagedSeriesSegment(groupName),
    slot.weekday,
    String(slot.time.hour),
    String(slot.time.minute),
    String(slotIndex)
  ].join('|');
}

function slotIndexInSchedule(slots, slot) {
  for (var i = 0; i < slots.length; i++) {
    var s = slots[i];
    if (s && s.weekday === slot.weekday && s.time.hour === slot.time.hour && s.time.minute === slot.time.minute) {
      return i;
    }
  }
  return 0;
}

function findRecurringMasterByManagedPrivate(calendarId, managedValue, schedule) {
  try {
    var startWindow = new Date(schedule.startDate.getTime());
    startWindow.setDate(startWindow.getDate() - 21);
    var endWindow = new Date(schedule.endDate.getTime());
    endWindow.setDate(endWindow.getDate() + 21);
    var response = Calendar.Events.list(calendarId, {
      timeMin: startWindow.toISOString(),
      timeMax: startOfNextDay(endWindow).toISOString(),
      singleEvents: false,
      privateExtendedProperty: MANAGED_SERIES_PRIVATE_KEY + '=' + managedValue
    });
    var items = response.items || [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      if (item.status === 'cancelled') continue;
      if (!item.recurrence) continue;
      return item;
    }
  } catch (e) {
    // fall through
  }
  return null;
}

function ensureManagedSeriesExtendedProps(calendarId, recurringMasterId, managedValue) {
  if (!recurringMasterId || !managedValue) return;
  runWithCalendarRetry(function() {
    var ev = Calendar.Events.get(calendarId, recurringMasterId);
    var priv = (ev.extendedProperties && ev.extendedProperties.private) || {};
    if (priv[MANAGED_SERIES_PRIVATE_KEY] === managedValue) return;
    priv[MANAGED_SERIES_PRIVATE_KEY] = managedValue;
    Calendar.Events.patch({
      extendedProperties: { private: priv }
    }, calendarId, recurringMasterId, { sendUpdates: 'none' });
  });
}

function apiRecurringIdToEventSeries(calendarId, recurringMasterId) {
  try {
    var ev = Calendar.Events.get(calendarId, recurringMasterId);
    if (!ev || !ev.iCalUID) return null;
    var calEvent = CalendarApp.getEventById(ev.iCalUID);
    if (!calEvent || !calEvent.isRecurringEvent()) return null;
    return calEvent.getEventSeries();
  } catch (e) {
    return null;
  }
}

function findCalendarAppSeriesByIcalUid(calendar, iCalUid, schedule) {
  if (!iCalUid) return null;
  var startWindow = new Date(schedule.startDate.getTime());
  startWindow.setDate(startWindow.getDate() - 14);
  var endWindow = new Date(schedule.endDate.getTime());
  endWindow.setDate(endWindow.getDate() + 14);
  var events = calendar.getEvents(startWindow, endWindow);
  for (var i = 0; i < events.length; i++) {
    var e = events[i];
    if (!e.isRecurringEvent()) continue;
    try {
      if (e.getId() === iCalUid) return e.getEventSeries();
    } catch (e2) {
      // continue
    }
  }
  return null;
}

function getRecurringApiIdManagedOrSlot(calendarId, groupName, slot, startDate, endDate, managedValue) {
  if (managedValue) {
    var schedule = { startDate: startDate, endDate: endDate };
    var master = findRecurringMasterByManagedPrivate(calendarId, managedValue, schedule);
    if (master && master.id) return master.id;
  }
  return getRecurringEventIdForSlotByListing(calendarId, groupName, slot, startDate, endDate);
}

function attendeeEmailsLower(attendees) {
  var out = [];
  var list = attendees || [];
  for (var i = 0; i < list.length; i++) {
    var a = list[i];
    if (a.organizer) continue;
    if (a.email) out.push(String(a.email).toLowerCase());
  }
  out.sort();
  return out;
}

function buildAttendeesForFutureInstance(currentAttendees, desiredEmails) {
  var desiredLower = {};
  for (var d = 0; d < desiredEmails.length; d++) {
    desiredLower[String(desiredEmails[d]).toLowerCase()] = desiredEmails[d];
  }
  var out = [];
  var seenLower = {};
  var cur = currentAttendees || [];
  for (var i = 0; i < cur.length; i++) {
    var a = cur[i];
    if (a.organizer) {
      out.push(a);
      continue;
    }
    var lo = a.email ? String(a.email).toLowerCase() : '';
    if (desiredLower.hasOwnProperty(lo)) {
      out.push(a);
      seenLower[lo] = true;
    }
  }
  for (var lo2 in desiredLower) {
    if (!desiredLower.hasOwnProperty(lo2)) continue;
    if (!seenLower[lo2]) {
      out.push({ email: desiredLower[lo2] });
    }
  }
  return out;
}

function attendeesListsEquivalentForGuests(a, b) {
  return attendeeEmailsLower(a).join(',') === attendeeEmailsLower(b).join(',');
}

/**
 * Sets attendee list on each future occurrence only (past instances unchanged).
 */
function syncFutureInstanceAttendees(calendarId, recurringEventId, desiredEmails, reportEntries, groupName) {
  if (!recurringEventId) {
    reportEntries.push(makeReportEntry({
      action: 'GUESTS_SYNC_SKIPPED_NO_FUTURE',
      groupName: groupName,
      details: 'No recurring event id; guest sync skipped'
    }));
    return;
  }
  var now = new Date();
  var timeMin = now.toISOString();
  var timeMax = new Date(now.getFullYear() + 3, 11, 31).toISOString();
  var pageToken;
  var patched = 0;
  var futureCount = 0;
  try {
    do {
      var resp = runWithCalendarRetry(function() {
        return Calendar.Events.instances(calendarId, recurringEventId, {
          timeMin: timeMin,
          timeMax: timeMax,
          maxResults: 250,
          pageToken: pageToken || undefined
        });
      });
      var items = resp.items || [];
      for (var i = 0; i < items.length; i++) {
        var inst = items[i];
        if (inst.status === 'cancelled') continue;
        var startField = inst.start && (inst.start.dateTime || inst.start.date);
        if (!startField) continue;
        var startDt = new Date(startField);
        if (startDt.getTime() < now.getTime()) continue;
        futureCount++;
        var nextAtt = buildAttendeesForFutureInstance(inst.attendees, desiredEmails);
        if (!attendeesListsEquivalentForGuests(inst.attendees, nextAtt)) {
          runWithCalendarRetry(function() {
            Calendar.Events.patch({
              attendees: nextAtt
            }, calendarId, inst.id, { sendUpdates: 'none' });
          });
          patched++;
        }
      }
      pageToken = resp.nextPageToken;
    } while (pageToken);

    if (futureCount === 0) {
      reportEntries.push(makeReportEntry({
        action: 'GUESTS_SYNC_SKIPPED_NO_FUTURE',
        groupName: groupName,
        details: 'No future instances; guest list not changed'
      }));
    } else {
      reportEntries.push(makeReportEntry({
        action: 'GUESTS_SYNC_FUTURE_ONLY_APPLIED',
        groupName: groupName,
        details: 'Future instances: ' + futureCount + ', attendee patches: ' + patched + ', desired guests: ' + desiredEmails.length
      }));
    }
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'GUESTS_SYNC_FUTURE_ONLY_FAILED',
      groupName: groupName,
      details: 'Future guest sync failed',
      errorReason: String(e)
    }));
  }
}

function toRruleUntilUtcFromEnd(endField) {
  var d = new Date(endField);
  if (isNaN(d.getTime())) return null;
  return Utilities.formatDate(d, 'UTC', "yyyyMMdd'T'HHmmss'Z'");
}

function buildRecurrenceTrimmedToUntil(originalRecurrence, untilUtc) {
  if (!originalRecurrence || originalRecurrence.length === 0 || !untilUtc) return originalRecurrence;
  var rruleLine = null;
  for (var r = 0; r < originalRecurrence.length; r++) {
    if (String(originalRecurrence[r]).indexOf('RRULE:') === 0) {
      rruleLine = originalRecurrence[r];
      break;
    }
  }
  if (!rruleLine) return originalRecurrence;
  var body = rruleLine.substring(6);
  var parts = body.split(';');
  var newParts = [];
  for (var i = 0; i < parts.length; i++) {
    var p = parts[i];
    if (!p) continue;
    if (p.indexOf('UNTIL=') === 0) continue;
    if (p.indexOf('COUNT=') === 0) continue;
    newParts.push(p);
  }
  newParts.push('UNTIL=' + untilUtc);
  var other = [];
  for (var j = 0; j < originalRecurrence.length; j++) {
    if (String(originalRecurrence[j]).indexOf('RRULE:') !== 0) {
      other.push(originalRecurrence[j]);
    }
  }
  return other.concat(['RRULE:' + newParts.join(';')]);
}

function seriesHasFutureInstances(calendarId, recurringEventId, fromDate) {
  var timeMin = fromDate.toISOString();
  var timeMax = new Date(fromDate.getFullYear() + 3, 11, 31).toISOString();
  try {
    var resp = Calendar.Events.instances(calendarId, recurringEventId, {
      timeMin: timeMin,
      timeMax: timeMax,
      maxResults: 1
    });
    return (resp.items && resp.items.length > 0);
  } catch (e) {
    return false;
  }
}

function getLastPastInstance(calendarId, recurringEventId, seriesStartIso, asOfDate) {
  var timeMax = asOfDate.toISOString();
  var pageToken;
  var last = null;
  try {
    do {
      var resp = Calendar.Events.instances(calendarId, recurringEventId, {
        timeMin: seriesStartIso,
        timeMax: timeMax,
        maxResults: 250,
        pageToken: pageToken || undefined
      });
      var items = resp.items || [];
      for (var i = 0; i < items.length; i++) {
        var it = items[i];
        if (it.status === 'cancelled') continue;
        last = it;
      }
      pageToken = resp.nextPageToken;
    } while (pageToken);
  } catch (e) {
    return null;
  }
  return last;
}

function trimOrDeleteObsoleteManagedSeries(calendarId, recurringEventId, reportEntries, summaryForLog) {
  var now = new Date();
  var master;
  try {
    master = Calendar.Events.get(calendarId, recurringEventId);
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'OBSOLETE_SERIES_CLEANUP_FAILED',
      groupName: '',
      details: summaryForLog || recurringEventId,
      errorReason: String(e)
    }));
    return;
  }
  if (!master.recurrence) return;

  var seriesStart = (master.start && (master.start.dateTime || master.start.date)) || now.toISOString();
  if (!seriesHasFutureInstances(calendarId, recurringEventId, now)) {
    return;
  }

  var lastPast = getLastPastInstance(calendarId, recurringEventId, seriesStart, now);
  if (!lastPast) {
    if (OBSOLETE_SERIES_CLEANUP_DRY_RUN) {
      reportEntries.push(makeReportEntry({
        action: 'OBSOLETE_SERIES_REMOVED_FUTURE_ONLY',
        details: '(dry-run) Would delete all-future obsolete series: ' + (summaryForLog || recurringEventId)
      }));
      return;
    }
    try {
      runWithCalendarRetry(function() {
        Calendar.Events.remove(calendarId, recurringEventId);
      });
      reportEntries.push(makeReportEntry({
        action: 'OBSOLETE_SERIES_REMOVED_FUTURE_ONLY',
        details: 'Deleted obsolete managed series (no past instances): ' + (summaryForLog || recurringEventId)
      }));
    } catch (e) {
      reportEntries.push(makeReportEntry({
        action: 'OBSOLETE_SERIES_CLEANUP_FAILED',
        details: summaryForLog || recurringEventId,
        errorReason: String(e)
      }));
    }
    return;
  }

  var endField = lastPast.end && (lastPast.end.dateTime || lastPast.end.date);
  if (!endField) return;
  var untilUtc = toRruleUntilUtcFromEnd(endField);
  if (!untilUtc) return;
  var newRec = buildRecurrenceTrimmedToUntil(master.recurrence, untilUtc);
  if (OBSOLETE_SERIES_CLEANUP_DRY_RUN) {
    reportEntries.push(makeReportEntry({
      action: 'OBSOLETE_SERIES_FUTURE_TRIMMED',
      details: '(dry-run) Would trim recurrence UNTIL=' + untilUtc + ' for ' + (summaryForLog || recurringEventId)
    }));
    return;
  }
  try {
    runWithCalendarRetry(function() {
      Calendar.Events.patch({
        recurrence: newRec
      }, calendarId, recurringEventId, { sendUpdates: 'none' });
    });
    reportEntries.push(makeReportEntry({
      action: 'OBSOLETE_SERIES_FUTURE_TRIMMED',
      details: 'Trimmed obsolete series to last past occurrence; UNTIL=' + untilUtc + ' ' + (summaryForLog || '')
    }));
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'OBSOLETE_SERIES_CLEANUP_FAILED',
      details: summaryForLog || recurringEventId,
      errorReason: String(e)
    }));
  }
}

function upsertSlotSeries(calendar, calendarId, bucket, slot, slotIndex, seriesEmails, description, reportEntries, desiredManagedKeys) {
  var managedValue = buildManagedSeriesPrivateValue(bucket.groupName, slot, slotIndex);
  var masterItem = findRecurringMasterByManagedPrivate(calendarId, managedValue, bucket.schedule);
  var seriesApp = null;
  var recurringApiId = null;
  var matchedManaged = false;

  if (masterItem && masterItem.id) {
    matchedManaged = true;
    recurringApiId = masterItem.id;
    seriesApp = apiRecurringIdToEventSeries(calendarId, masterItem.id);
    if (!seriesApp) {
      try {
        var evMeta = Calendar.Events.get(calendarId, masterItem.id);
        if (evMeta && evMeta.iCalUID) {
          seriesApp = findCalendarAppSeriesByIcalUid(calendar, evMeta.iCalUID, bucket.schedule);
        }
      } catch (eMeta) {
        // fall through to legacy search
      }
    }
    reportEntries.push(makeReportEntry({
      action: 'SERIES_MATCHED_BY_MANAGED_KEY',
      groupName: bucket.groupName,
      details: 'slot ' + slotIndex + ' managed=' + managedValue
    }));
  }

  if (!seriesApp) {
    seriesApp = findExistingGroupSeriesForSlot(calendar, bucket, slot);
    if (!seriesApp && slotIndex === 0) {
      seriesApp = findExistingGroupSeries(calendar, bucket);
    }
    if (seriesApp) {
      if (!matchedManaged) {
        reportEntries.push(makeReportEntry({
          action: 'SERIES_MATCHED_LEGACY_FALLBACK',
          groupName: bucket.groupName,
          details: 'slot ' + slotIndex
        }));
      }
      if (!recurringApiId) {
        recurringApiId = getRecurringEventIdForSlotByListing(calendarId, bucket.groupName, slot, bucket.schedule.startDate, bucket.schedule.endDate);
      }
      if (recurringApiId) {
        ensureManagedSeriesExtendedProps(calendarId, recurringApiId, managedValue);
      }
    }
  }

  desiredManagedKeys[managedValue] = true;

  if (seriesApp) {
    updateSeries(calendar, seriesApp, bucket, slot, seriesEmails, description, reportEntries, calendarId, recurringApiId);
    return { series: seriesApp, created: false };
  }
  var created = createSeries(calendar, bucket, slot, seriesEmails, description, reportEntries, calendarId, managedValue);
  return { series: created, created: true };
}

/**
 * Removes future occurrences for managed series that are no longer present in the sheet.
 */
function cleanupObsoleteManagedSeries(calendarId, desiredManagedKeys, reportEntries) {
  var now = new Date();
  var timeMin = new Date(now.getFullYear() - 2, 0, 1).toISOString();
  var timeMax = new Date(now.getFullYear() + 2, 11, 31).toISOString();
  var pageToken;
  var seenId = {};
  try {
    do {
      var resp = Calendar.Events.list(calendarId, {
        timeMin: timeMin,
        timeMax: timeMax,
        maxResults: 250,
        pageToken: pageToken || undefined,
        singleEvents: false,
        privateExtendedProperty: MANAGED_SERIES_PRIVATE_KEY
      });
      var items = resp.items || [];
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        if (item.status === 'cancelled') continue;
        if (!item.recurrence || !item.id) continue;
        if (seenId[item.id]) continue;
        seenId[item.id] = true;
        var priv = item.extendedProperties && item.extendedProperties.private;
        if (!priv || !priv[MANAGED_SERIES_PRIVATE_KEY]) continue;
        var val = priv[MANAGED_SERIES_PRIVATE_KEY];
        if (desiredManagedKeys[val]) continue;
        var logLabel = item.summary + ' [' + val + ']';
        trimOrDeleteObsoleteManagedSeries(calendarId, item.id, reportEntries, logLabel);
      }
      pageToken = resp.nextPageToken;
    } while (pageToken);
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'OBSOLETE_SERIES_CLEANUP_FAILED',
      details: 'cleanupObsoleteManagedSeries list/pagination',
      errorReason: String(e)
    }));
  }
}

function upsertEventsForGroups(calendar, validation, reportEntries, calendarId, desiredManagedKeys) {
  validation.validGroups.forEach(function(bucket) {
    var parts = partitionParticipants(bucket);
    var seriesParticipants = parts.seriesParticipants;
    var trialParticipants = parts.trialParticipants;

    var seriesEmails = seriesParticipants.map(function(r) { return r.participantEmail; });
    var canonicalRow = seriesParticipants[0] || bucket.rows[0];
    var description = renderInvitationBody(canonicalRow);

    var needSeries = seriesEmails.length > 0 || trialParticipants.length > 0 || CREATE_EVENTS_WITH_NO_CONFIRMED_ATTENDEES;
    if (!needSeries) {
      reportEntries.push(makeReportEntry({
        action: 'GROUP_SKIPPED_NO_ATTENDEES',
        groupName: bucket.groupName,
        details: 'Group has no confirmed non-trial participants'
      }));
      return;
    }

    var slots = bucket.schedule.slots;
    if (slots.length < 2) {
      reportEntries.push(makeReportEntry({
        action: 'DEBUG_ONLY_ONE_SLOT',
        groupName: bucket.groupName,
        details: 'slots.length=' + slots.length + '; day1=' + (slots[0] ? slots[0].weekday : '') +
          ' time1=' + (slots[0] ? (slots[0].time.hour + ':' + (slots[0].time.minute < 10 ? '0' : '') + slots[0].time.minute) : '')
      }));
    }

    // Primary slot (Dzień #1 / Godzina #1)
    var primarySlot = slots[0];
    var primaryResult = upsertSlotSeries(calendar, calendarId, bucket, primarySlot, 0, seriesEmails, description, reportEntries, desiredManagedKeys);
    var primarySeries = primaryResult.series;

    // Secondary slot (Dzień #2 / Godzina #2) if present
    if (slots.length > 1 && slots[1] && slots[1].weekday && slots[1].time) {
      upsertSlotSeries(calendar, calendarId, bucket, slots[1], 1, seriesEmails, description, reportEntries, desiredManagedKeys);
    }

    // Trial participants: attach to the correct series (slot) based on the trial date weekday
    if (trialParticipants.length > 0) {
      if (primaryResult.created) {
        Utilities.sleep(1500);
      }

      trialParticipants.forEach(function(row) {
        if (!row.trialDate) return;
        var jsDay = row.trialDate.getDay(); // 0-6
        var token = jsDayToToken(jsDay);
        if (!token) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_SLOT_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'Trial date weekday not supported for ' + row.participantEmail
          }));
          return;
        }

        // Find matching slot for this weekday
        var matchingSlot = null;
        for (var si = 0; si < slots.length; si++) {
          var s = slots[si];
          if (s && s.weekday === token) {
            matchingSlot = s;
            break;
          }
        }

        if (!matchingSlot) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_SLOT_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'No slot for weekday ' + token + ' for ' + row.participantEmail
          }));
          return;
        }

        var trialSlotIndex = slotIndexInSchedule(slots, matchingSlot);
        var trialManagedValue = buildManagedSeriesPrivateValue(bucket.groupName, matchingSlot, trialSlotIndex);
        var recurringEventIdForSlot = getRecurringApiIdManagedOrSlot(
          calendarId,
          bucket.groupName,
          matchingSlot,
          bucket.schedule.startDate,
          bucket.schedule.endDate,
          trialManagedValue
        );

        if (!recurringEventIdForSlot) {
          reportEntries.push(makeReportEntry({
            action: 'TRIAL_INSTANCE_NOT_FOUND',
            groupName: bucket.groupName,
            rowIndex: row.rowIndex,
            details: 'No recurring series found for weekday ' + token +
              ' and time ' + matchingSlot.time.hour + ':' + (matchingSlot.time.minute < 10 ? '0' : '') + matchingSlot.time.minute,
            errorReason: 'No matching recurring series for slot'
          }));
          return;
        }

        addTrialGuestToInstance(
          calendarId,
          recurringEventIdForSlot,
          row.trialDate,
          row.participantEmail,
          matchingSlot,
          reportEntries,
          bucket.groupName,
          row.rowIndex
        );
      });
    }
  });
}

function partitionParticipants(bucket) {
  var series = [];
  var trials = [];

  bucket.rows.forEach(function(row) {
    var hasTrial = row.trialDate &&
      row.trialDate.getTime() >= bucket.schedule.startDate.getTime() &&
      row.trialDate.getTime() <= bucket.schedule.endDate.getTime();

    if (hasTrial && row.confirmed) {
      trials.push(row);
    } else if (row.confirmed) {
      series.push(row);
    }
  });

  return {
    seriesParticipants: series,
    trialParticipants: trials
  };
}

function toAppsScriptWeekday(token) {
  switch (token) {
    case 'Mon': return CalendarApp.Weekday.MONDAY;
    case 'Tue': return CalendarApp.Weekday.TUESDAY;
    case 'Wed': return CalendarApp.Weekday.WEDNESDAY;
    case 'Thu': return CalendarApp.Weekday.THURSDAY;
    case 'Fri': return CalendarApp.Weekday.FRIDAY;
    default: throw new Error('Unsupported weekday token: ' + token);
  }
}

function jsWeekdayFromToken(token) {
  // JS getDay(): Sun=0, Mon=1, ... Sat=6
  switch (token) {
    case 'Mon': return 1;
    case 'Tue': return 2;
    case 'Wed': return 3;
    case 'Thu': return 4;
    case 'Fri': return 5;
    default:
      throw new Error('Unsupported weekday token for alignment: ' + token);
  }
}

function jsDayToToken(jsDay) {
  // JS getDay(): Sun=0, Mon=1, ... Sat=6
  switch (jsDay) {
    case 1: return 'Mon';
    case 2: return 'Tue';
    case 3: return 'Wed';
    case 4: return 'Thu';
    case 5: return 'Fri';
    default: return null;
  }
}

function alignDateToWeekday(baseDate, weekdayToken) {
  var targetDow = jsWeekdayFromToken(weekdayToken);
  var d = new Date(baseDate.getTime());
  var currentDow = d.getDay(); // 0–6
  var delta = (targetDow - currentDow + 7) % 7; // 0–6 days forward
  d.setDate(d.getDate() + delta);
  return d;
}

function createSeries(calendar, bucket, slot, emails, description, reportEntries, calendarId, managedValue) {
  var schedule = bucket.schedule;
  var primarySlot = slot;

  var alignedStartDate = alignDateToWeekday(schedule.startDate, primarySlot.weekday);
  var start = new Date(alignedStartDate.getTime());
  start.setHours(primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000); // 1 hour

  var recurrence = CalendarApp.newRecurrence()
    .addWeeklyRule()
    .until(startOfNextDay(schedule.endDate));

  // Only this slot's weekday
  recurrence.onlyOnWeekday(toAppsScriptWeekday(primarySlot.weekday));
  recurrence.setTimeZone(Session.getScriptTimeZone());

  var eventSeries = runWithCalendarRetry(function() {
    var series = calendar.createEventSeries(bucket.groupName, start, end, recurrence, {
      description: description,
      guests: emails.join(','),
      sendInvites: false
    });
    return series;
  });

  reportEntries.push(makeReportEntry({
    action: 'EVENT_CREATED',
    groupName: bucket.groupName,
    details: 'Created recurring event; attendees: ' + emails.length
  }));

  if (calendarId && managedValue) {
    Utilities.sleep(800);
    var recurringId = getRecurringEventIdForSlotByListing(calendarId, bucket.groupName, slot, schedule.startDate, schedule.endDate);
    if (recurringId) {
      ensureManagedSeriesExtendedProps(calendarId, recurringId, managedValue);
    }
  }

  return eventSeries;
}

function updateSeries(calendar, series, bucket, slot, emails, description, reportEntries, calendarId, recurringApiId) {
  series.setDescription(description);

  var schedule = bucket.schedule;
  var primarySlot = slot;
  var alignedStartDate = alignDateToWeekday(schedule.startDate, primarySlot.weekday);
  var start = new Date(alignedStartDate.getTime());
  start.setHours(primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000);
  var recurrence = CalendarApp.newRecurrence()
    .addWeeklyRule()
    .until(startOfNextDay(schedule.endDate));

  recurrence.onlyOnWeekday(toAppsScriptWeekday(primarySlot.weekday));
  recurrence.setTimeZone(Session.getScriptTimeZone());

  runWithCalendarRetry(function() {
    series.setTime(start, end);
    series.setRecurrence(recurrence);
  });

  var apiId = recurringApiId || getRecurringEventIdForSlotByListing(calendarId, bucket.groupName, slot, schedule.startDate, schedule.endDate);
  syncFutureInstanceAttendees(calendarId, apiId, emails, reportEntries, bucket.groupName);

  reportEntries.push(makeReportEntry({
    action: 'EVENT_UPDATED',
    groupName: bucket.groupName,
    details: 'Updated recurring event (time/recurrence/description); future-only guest sync applied separately'
  }));
}

function findExistingGroupSeries(calendar, bucket) {
  // Approximate: find recurring events with matching title whose first occurrence
  // falls within the group date range.
  var startWindow = new Date(bucket.schedule.startDate.getTime());
  startWindow.setDate(startWindow.getDate() - 7);
  var endWindow = new Date(bucket.schedule.endDate.getTime());
  endWindow.setDate(endWindow.getDate() + 7);

  var events = calendar.getEvents(startWindow, endWindow);
  for (var i = 0; i < events.length; i++) {
    var e = events[i];
    if (!e.isRecurringEvent()) continue;
    if (e.getTitle() !== bucket.groupName) continue;

    var eStart = e.getStartTime();
    if (eStart >= bucket.schedule.startDate && eStart <= bucket.schedule.endDate) {
      return e.getEventSeries();
    }
  }
  return null;
}

function findExistingGroupSeriesForSlot(calendar, bucket, slot) {
  var schedule = bucket.schedule;
  var startWindow = new Date(schedule.startDate.getTime());
  startWindow.setDate(startWindow.getDate() - 7);
  var endWindow = new Date(schedule.endDate.getTime());
  endWindow.setDate(endWindow.getDate() + 7);

  var desiredDow = jsWeekdayFromToken(slot.weekday);
  var desiredHour = slot.time.hour;
  var desiredMinute = slot.time.minute;

  var events = calendar.getEvents(startWindow, endWindow);
  for (var i = 0; i < events.length; i++) {
    var e = events[i];
    if (!e.isRecurringEvent()) continue;
    if (e.getTitle() !== bucket.groupName) continue;

    var eStart = e.getStartTime();
    if (eStart < schedule.startDate || eStart > schedule.endDate) continue;
    if (eStart.getDay() !== desiredDow) continue;
    if (eStart.getHours() !== desiredHour || eStart.getMinutes() !== desiredMinute) continue;

    return e.getEventSeries();
  }
  return null;
}

/**
 * Returns the recurring event id for the series (for use with Calendar API instances/patch).
 * CalendarEventSeries.getId() returns iCalUID; the API instances() endpoint needs the short event id.
 * So we look up the recurring event by listing events in the schedule range and matching by title.
 */
function getRecurringEventIdFromSeries(series) {
  try {
    return series.getId();
  } catch (e) {
    return null;
  }
}

/**
 * Gets the short recurring event id for a specific slot via Calendar API list.
 * Filters by groupName, date window, weekday and time for the slot.
 */
function getRecurringEventIdForSlotByListing(calendarId, groupName, slot, startDate, endDate) {
  try {
    var startWindow = new Date(startDate.getTime());
    startWindow.setDate(startWindow.getDate() - 7);
    var endWindow = new Date(endDate.getTime());
    endWindow.setDate(endWindow.getDate() + 7);

    var timeMin = startWindow.toISOString();
    var timeMax = startOfNextDay(endWindow).toISOString();

    var desiredDow = jsWeekdayFromToken(slot.weekday);
    var desiredHour = slot.time.hour;
    var desiredMinute = slot.time.minute;

    var response = Calendar.Events.list(calendarId, {
      timeMin: timeMin,
      timeMax: timeMax,
      singleEvents: false
    });
    var items = response.items || [];
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      if (item.summary !== groupName) continue;
      if (!item.recurrence) continue;

      var startField = item.start && (item.start.dateTime || item.start.date);
      if (!startField) continue;
      var d = new Date(startField);
      if (isNaN(d.getTime())) continue;

      if (d.getDay() !== desiredDow) continue;

      // If this is a timed event, also check the time of day
      if (item.start.dateTime) {
        if (d.getHours() !== desiredHour || d.getMinutes() !== desiredMinute) continue;
      }

      return item.id;
    }
  } catch (e) {
    // fall through
  }
  return null;
}

/**
 * Adds trial guest to the single occurrence on trialDate via Calendar API (per-slot).
 * Requires Calendar Advanced Service (Google Calendar API) to be enabled.
 */
function addTrialGuestToInstance(calendarId, recurringEventId, trialDate, trialEmail, slot, reportEntries, groupName, rowIndex) {
  var primarySlot = slot;
  // Use calendar date (y/m/d) in script timezone so "2026-03-11" in sheet stays March 11, not March 10 UTC
  var y = trialDate.getFullYear();
  var m = trialDate.getMonth();
  var d = trialDate.getDate();
  var start = new Date(y, m, d, primarySlot.time.hour, primarySlot.time.minute, 0, 0);
  var end = new Date(start.getTime() + 60 * 60 * 1000);
  var timeMin = start.toISOString();
  var timeMax = end.toISOString();
  var dateStr = y + '-' + (m + 1 < 10 ? '0' : '') + (m + 1) + '-' + (d < 10 ? '0' : '') + d;

  try {
    runWithCalendarRetry(function() {
      var response = Calendar.Events.instances(calendarId, recurringEventId, {
        timeMin: timeMin,
        timeMax: timeMax
      });
      var items = response.items || [];
      if (items.length === 0) {
        reportEntries.push(makeReportEntry({
          action: 'TRIAL_INSTANCE_NOT_FOUND',
          groupName: groupName,
          rowIndex: rowIndex,
          details: 'No occurrence on ' + dateStr + ' for trial guest ' + trialEmail,
          errorReason: 'Instance not in recurrence window or series not found'
        }));
        return;
      }
      var instance = items[0];
      var attendees = instance.attendees || [];
      var hasAlready = attendees.some(function(a) { return a.email === trialEmail; });
      if (!hasAlready) {
        attendees.push({ email: trialEmail });
        var timeZone = Session.getScriptTimeZone();
        var exceptionEvent = {
          recurringEventId: recurringEventId,
          originalStartTime: instance.originalStartTime || { dateTime: timeMin, timeZone: timeZone },
          start: instance.start || { dateTime: timeMin, timeZone: timeZone },
          end: instance.end || { dateTime: timeMax, timeZone: timeZone },
          summary: instance.summary || groupName,
          description: instance.description || '',
          attendees: attendees
        };
        Calendar.Events.insert(exceptionEvent, calendarId, { sendUpdates: 'none' });
      }
      reportEntries.push(makeReportEntry({
        action: 'TRIAL_GUEST_ADDED_TO_INSTANCE',
        groupName: groupName,
        rowIndex: rowIndex,
        details: 'Added ' + trialEmail + ' to occurrence on ' + dateStr
      }));
    });
  } catch (e) {
    reportEntries.push(makeReportEntry({
      action: 'TRIAL_GUEST_ADD_FAILED',
      groupName: groupName,
      rowIndex: rowIndex,
      details: 'Failed to add trial guest ' + trialEmail + ' to instance on ' + dateStr,
      errorReason: String(e)
    }));
  }
}

/******************************
 * RUN REPORT (Phase 1 & 4)
 ******************************/

function makeReportEntry(fields) {
  return {
    timestamp: new Date(),
    rowIndex: fields.rowIndex || '',
    groupName: fields.groupName || '',
    action: fields.action || '',
    details: fields.details || '',
    errorReason: fields.errorReason || ''
  };
}

/**
 * Builds a map of groupName -> count of successfully created events from report entries.
 * Only counts entries with action === 'EVENT_CREATED'.
 */
function getCreatedEventsByGroup(reportEntries) {
  var createdByGroup = {};
  reportEntries.forEach(function(e) {
    if (e.action === 'EVENT_CREATED' && e.groupName) {
      var name = String(e.groupName).trim();
      if (name) {
        createdByGroup[name] = (createdByGroup[name] || 0) + 1;
      }
    }
  });
  return createdByGroup;
}

/**
 * Shows a popup alert summarizing which groups had calendar events created and how many per group.
 * Safe to call when UI is unavailable (e.g. trigger); does nothing in that case.
 */
function showCreatedEventsSummary(reportEntries) {
  try {
    var ui = SpreadsheetApp.getUi();
    if (!ui) return;

    var createdByGroup = getCreatedEventsByGroup(reportEntries);
    var groupNames = Object.keys(createdByGroup);
    var message;

    if (groupNames.length === 0) {
      message = 'Nie utworzono żadnych nowych wydarzeń w kalendarzu.';
    } else {
      message = 'Utworzono wydarzenia w następujących grupach:\n\n';
      groupNames.forEach(function(name) {
        var count = createdByGroup[name];
        var word = count === 1 ? 'wydarzenie' : (count >= 2 && count <= 4 ? 'wydarzenia' : 'wydarzeń');
        message += '- ' + name + ': ' + count + ' ' + word + '\n';
      });
    }

    ui.alert('Synchronizacja kalendarza', message, ui.ButtonSet.OK);
  } catch (e) {
    Logger.log('showCreatedEventsSummary: ' + (e && e.message ? e.message : String(e)));
  }
}

function writeRunReport(ss, entries) {
  var sheet = ss.getSheetByName(REPORT_SHEET_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(REPORT_SHEET_NAME);
  }

  sheet.clearContents();

  var header = ['Timestamp', 'RowIndex', 'GroupName', 'Action', 'Details', 'ErrorReason'];
  var rows = [header];

  entries.forEach(function(e) {
    rows.push([
      e.timestamp,
      e.rowIndex,
      e.groupName,
      e.action,
      e.details,
      e.errorReason
    ]);
  });

  var range = sheet.getRange(1, 1, rows.length, header.length);
  range.setValues(rows);
}

/******************************
 * OPTIONAL: MENU
 ******************************/

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Zarządzanie wydarzeniami')
    .addItem('Utwórz wydarzenia', 'runSync')
    .addSeparator()
    .addItem('Usuń wydarzenia', 'deleteEventsByGroup_1_1_withUi')
    .addToUi();
}